# Base
DATABASE_URL=postgres://localhost/solucionador_local
AUTH_SECRET=                # openssl rand -base64 48
APP_URL=http://localhost:3090
ADMIN_EMAIL=                # esa cuenta entra a /admin

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Flow (sandbox por defecto; FLOW_ENV=production para cobrar de verdad)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox

# Correo (sin clave, los correos quedan en la tabla envios sin salir)
RESEND_API_KEY=
EMAIL_FROM=Solucionador <hola@tudominio.cl>

# Cron de Railway: GET /api/cron/seguimiento con Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
